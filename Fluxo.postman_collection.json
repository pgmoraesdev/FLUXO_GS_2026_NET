{
  "info": {
    "name": "Fluxo API | CRUD de teste",
    "description": "Inicie a API e ajuste baseUrl nas variáveis da coleção se a porta for diferente. Execute a coleção na ordem exibida para cadastrar, consultar, atualizar e excluir registros de teste. A plataforma usa o ID da estação criada na primeira pasta. A exclusão da estação fica na última pasta para preservar esse vínculo até o fim do teste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5248",
      "type": "string"
    },
    {
      "key": "estacaoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "plataformaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tremId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Estações",
      "item": [
        {
          "name": "Cadastrar",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"estacaoId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Guardar ID do registro criado\", function () {",
                  "        const id = pm.response.json().id;",
                  "        pm.expect(Number.isInteger(id) && id > 0).to.eql(true);",
                  "        pm.collectionVariables.set(\"estacaoId\", String(id));",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Estacao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Estacao"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Estação de teste {{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/Estacao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Estacao"
              ]
            }
          }
        },
        {
          "name": "Consultar por ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!/^[1-9]\\d*$/.test(String(pm.collectionVariables.get(\"estacaoId\") || \"\"))) {",
                  "    console.warn(\"Execute primeiro o cadastro que preenche estacaoId.\");",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
