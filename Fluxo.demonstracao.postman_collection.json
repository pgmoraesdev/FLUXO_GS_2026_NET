        {
          "name": "01 — Cadastrar estação da demonstração",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"demoEstacaoId\");",
                  "pm.collectionVariables.unset(\"demoPlataformaId\");",
                  "pm.collectionVariables.unset(\"demoTremId\");",
                  "pm.collectionVariables.unset(\"demoVagao1Id\");",
                  "pm.collectionVariables.unset(\"demoVagao2Id\");",
                  "pm.collectionVariables.unset(\"demoVagao3Id\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const id = pm.response.json().id; pm.test(\"ID válido\", () => pm.expect(Number.isInteger(id) && id > 0).to.eql(true)); pm.collectionVariables.set(\"demoEstacaoId\", String(id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Estacao",
            "body": {
              "mode": "raw",
              "raw": "{\"nome\":\"Estação DEMO {{$guid}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
